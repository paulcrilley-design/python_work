# This will provide examples of numbers, ranges and lists

for value in range(1, 5):  # This will iterate from 1 to 10
    print(f"{value}\n")  # Print each value in the range and add a new line after each value

numbers = list(range(1, 6))  # This will create a list of numbers from 1 to 5
print(numbers)  # Print the list of numbers

even_numbers = list(range(2, 11, 2))  # This will create a list of even numbers from 2 to 10
print(even_numbers)  # Print the list of even numbers  



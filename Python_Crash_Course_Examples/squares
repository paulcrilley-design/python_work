cubes = []  # Create an empty list to hold the cubes of numbers
for value in range(1, 11):  # This will iterate from 1 to 10
    cube = value ** 3  # Calculate the cube of the current value
    cubes.append(cube)  # Append the cube to the list of cubes
print(cubes)  # Print the list of cubes 

cubes = [value**3 for value in range(1, 11)]  # This is a list comprehension that creates a list of cubes from 1 to 10
print(cubes)  # Print the list of cubes

squares = []  # Create an empty list to hold the squares of numbers
for value in range(1, 11):  # This will iterate from 1 to 10
    square = value ** 2  # Calculate the square of the current value
    squares.append(square)  # Append the square to the list of squares
print(squares)  # Print the list of squares 

squares = []  # This is another way to create a list of squares using a for loop
for value in range(1, 11):  # This will iterate from 1 to 10
    squares.append(value**2)  # Append the square to the list of squares
print(squares)  # Print the list of squares 

squares = [value**2 for value in range(1, 12)]  # This is a list comprehension that creates a list of squares from 1 to 11
print(squares)  # Print the list of squares


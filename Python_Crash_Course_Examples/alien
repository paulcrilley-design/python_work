# These are dictionary examples
# Dictionaries are like lists, but are enclosed in 'curly-brackets' and not 'square-brackets'
# Dictionaries consist of key / value pairs. The 'Key' is separated from the 'Value' using a :
# It is often useful to create an empty dictionary, and then add key/value pairs based on interactions with a user. Such as user details, name, age, address etc.

alien_0 = {}
alien_0['color'] = 'green'
alien_0['points'] = 5
print(alien_0)
print(alien_0['color'])
print(alien_0['points'])

# Dictionary 'values' are accessed by referencing the 'value' associated with the relevant 'key'
new_points = alien_0['points']
print(f"You just earned {new_points} points!")

# Additional items can be added to Dictionaries
alien_0['x_position'] = 0
alien_0['y_position'] = 25
print(alien_0)

# We can change the dictionary key/value details easily
alien_0['color'] = 'yellow'
print(f"The Alien color is now {alien_0['color']}")

alien_0['speed'] = 'medium'
print(alien_0)
print(f"Original position of Alien is {alien_0['x_position']}")
if alien_0['speed'] == 'slow':
    x_increment = 1
elif alien_0['speed'] == 'medium':
    x_increment = 2
else:
    # This must be a Fast Alien
    x_increment = 3
# The new position is the original position plus the new position
alien_0['x_position'] = alien_0['x_position'] + x_increment
print(f"New position of Alien is {alien_0['x_position']}")

# We can also delete key/value pairs if required
del alien_0['points']
print(alien_0)

